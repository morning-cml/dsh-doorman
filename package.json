{
  "name": "dsh-doorman",
  "version": "0.2.2",
  "description": "Unofficial DeepSeek Harness plugin that triages sandbox-escalation approvals: hard rules plus a second-model review. Stage 2: observe-only; every prompt still reaches you.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
